+++ b/tests/repro_issue.py
@@ -0,0 +1,20 @@
+import unittest
+from cachetools import TLRUCache
+
+class TestTLRUCacheOverwritingExpired(unittest.TestCase):
+    def test_overwriting_expired_removes_key(self):
+        def ttu(_key, value, now):
+            return now + value
+
+        cache = TLRUCache(maxsize=2, ttu=ttu, timer=lambda: 0)
+        cache[1] = 5
+        self.assertEqual(cache[1], 5)
+        
+        # This should expire on arrival and remove the key
+        cache[1] = 0
+        
+        self.assertNotIn(1, cache)
+        self.assertIsNone(cache.get(1))
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.currsize, 0)
+        self.assertEqual(set(cache), set())
