@@ -0,0 +1,26 @@
+import unittest
+from cachetools import TLRUCache
+
+class TestTLRUCacheOverwrite(unittest.TestCase):
+    def test_overwrite_expired_value(self):
+        def ttu(_key, value, now):
+            return now + value
+
+        cache = TLRUCache(maxsize=2, ttu=ttu)
+        
+        # Test setup: expired value 0. timer starts at 0.
+        # ttu(1, 5, 0) = 5. timer is 0. 5 > 0.
+        # So key 1, value 5 is valid.
+        cache[1] = 5
+        
+        # Now store value 0.
+        # ttu(1, 0, 0) = 0.
+        # 0 is not > timer 0 (if timer 0).
+        # But wait, how does ttu work? 
+        # TLRU says: "a value of 0 is expired the moment it is stored".
+        # If ttu returns time <= now, it shouldn't be added?
+        
+        cache[1] = 0
+        
+        self.assertNotIn(1, cache, "Key should be gone after storing expired value")
+        self.assertEqual(len(cache), 0, "Cache should be empty")
