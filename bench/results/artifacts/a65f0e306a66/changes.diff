+
+    @property
+    def name(self):
+        if self._name is None:
+            self._name = self._generate_unique_name()
+        return self._name
+
+    def _generate_unique_name(self):
+        if len(Robot._used_names) >= 26 * 26 * 1000:
+            raise RuntimeError("All possible robot names are taken.")
+        while True:
+            letters = "".join(random.choices(string.ascii_uppercase, k=2))
+            digits = "".join(random.choices(string.digits, k=3))
+            candidate = letters + digits
+            if candidate not in Robot._used_names and candidate != self._previous_name:
+                Robot._used_names.add(candidate)
+                return candidate
+
+    def reset(self):
+        if self._name is not None:
+            Robot._used_names.discard(self._name)
+            self._previous_name = self._name
