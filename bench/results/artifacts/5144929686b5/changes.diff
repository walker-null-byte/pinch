+++ b/test_tool.py
@@ -0,0 +1,31 @@
+import os
+import subprocess
+import sys
+import pytest
+from click.testing import CliRunner
+from tool import cli
+
+
+def test_version_default(monkeypatch):
+    monkeypatch.delenv("TOOL_CONFIG", raising=False)
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--version"])
+    assert result.exit_code == 0
+    # Depending on runner context, command path might be 'cli' or 'tool' or similar. Let's check what click context command path is.
+    # Actually, click.version_option callback prints `ctx.find_root().command_path` or `ctx.command_path`. Let's verify output format.
+    assert "1.4.2 (config: default)" in result.output
+
+
+def test_version_with_env(monkeypatch):
+    monkeypatch.setenv("TOOL_CONFIG", "/etc/tool.toml")
+    runner = CliRunner()
+    result = runner.invoke(cli, ["--version"])
+    assert result.exit_code == 0
+    assert "1.4.2 (config: /etc/tool.toml)" in result.output
+
+
+def test_hello():
+    runner = CliRunner()
+    result = runner.invoke(cli, ["hello"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "hello"
