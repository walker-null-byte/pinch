+import os
 import click
 
 
+def _version_callback(ctx):
+    config = os.environ.get("TOOL_CONFIG", "default")
+    return f"{ctx.command_path} 1.4.2 (config: {config})"
+
+
 @click.group()
+@click.custom_version_option(_version_callback)
 def cli():
     """Example tool."""
 
