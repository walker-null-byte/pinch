diff --git a/work/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..3ba5b4b
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,18 @@
+import more_itertools as mi
+
+class AllowedKeys(set):
+    def __call__(self, key):
+        return key in self
+
+allowed = AllowedKeys()          # empty, so bool(allowed) is False
+D = mi.bucket(iter([10, 20, 11, 21]), key=lambda x: x, validator=allowed)
+
+print(f"bool(allowed): {bool(allowed)}")
+print(f"D[10] items: {list(D[10])}")
+print(f"10 in D: {10 in D}")
+print(f"set(D): {set(D)}")
+
+# Assertions to confirm the behavior
+assert list(D[10]) == [], f"Expected [], got {list(D[10])}"
+assert 10 not in D, f"Expected 10 not in D, but it is."
+assert set(D) == set(), f"Expected set(), got {set(D)}"
