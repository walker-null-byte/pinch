@@ -0,0 +1,52 @@
+import more_itertools as mi
+from collections import deque, defaultdict
+
+# Mocking the bucket behavior for debugging
+class MockBucket:
+    def __init__(self, iterable, key, validator):
+        self._it = iter(iterable)
+        self._key = key
+        self._cache = defaultdict(deque)
+        self._validator = validator
+
+    def __getitem__(self, value):
+        # We need a simplified _get_values
+        print(f"Calling _get_values for {value}")
+        return self._get_values(value)
+
+    def _get_values(self, value):
+        # This is the actual implementation of _get_values from more.py,
+        # but simplified for our debug purposes
+        while True:
+            if self._cache.get(value):
+                yield self._cache[value].popleft()
+            else:
+                while True:
+                    try:
+                        item = next(self._it)
+                    except StopIteration:
+                        return
+                    item_value = self._key(item)
+                    if item_value == value:
+                        if value not in self._cache:
+                            self._cache[value] = deque()
+                        yield item
+                        break
+                    elif self._validator(item_value):
+                        self._cache[item_value].append(item)
+
+    def __contains__(self, value):
+        if not self._validator(value):
+            return False
+        try:
+            item = next(self[value])
+        except StopIteration:
+            return False
+        else:
+            self._cache[value].appendleft(item)
+        return True
+
+validator = lambda x: x in {10, 20}
+D = MockBucket(iter([10, 20, 11, 21]), key=lambda x: x, validator=validator)
+# Before running 10 in D, let's see if 10 is actually in the iterable
+print(f"10 in D: {10 in D}")
