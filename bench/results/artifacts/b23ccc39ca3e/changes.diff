--- /dev/null
+++ b/tests/test_bucket_validator_fix.py
@@ -0,0 +1,31 @@
+import more_itertools as mi
+import pytest
+
+def test_bucket_falsey_validator():
+    class AllowedKeys(set):
+        def __call__(self, key):
+            return key in self
+
+    allowed = AllowedKeys()  # empty, so bool(allowed) is False
+    
+    # In the original code, this failed to use the validator and acted as if no validator was provided.
+    D = mi.bucket(iter([10, 20, 11, 21]), key=lambda x: x, validator=allowed)
+    
+    # validator should reject every key, so this should be []
+    assert list(D[10]) == []
+    assert 10 not in D
+    assert set(D) == set()
+
+def test_bucket_truthy_validator():
+    # A standard validator
+    validator = lambda x: x in {10, 20}
+    D = mi.bucket(iter([10, 20, 11, 21]), key=lambda x: x, validator=validator)
+    
+    # Let's not call list(D[10]) first.
+    assert 10 in D
+    
+    # Now check the elements
+    assert list(D[10]) == [10]
+    assert list(D[11]) == []
+    assert 11 not in D
+    assert set(D) == {10, 20}
