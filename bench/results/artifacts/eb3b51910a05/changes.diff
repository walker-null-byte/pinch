+def proverb(*args, qualifier=None):
+    if not args:
+        return []
+    
+    result = []
+    for i in range(len(args) - 1):
+        result.append(f"For want of a {args[i]} the {args[i+1]} was lost.")
+    
+    final_nail = f"{qualifier + ' ' if qualifier else ''}{args[0]}"
+    result.append(f"And all for the want of a {final_nail}.")
+    
+    return result
