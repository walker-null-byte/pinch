+ANIMALS = [
+    ("fly", ""),
+    ("spider", "It wriggled and jiggled and tickled inside her."),
+    ("bird", "How absurd to swallow a bird!"),
+    ("cat", "Imagine that, to swallow a cat!"),
+    ("dog", "What a hog, to swallow a dog!"),
+    ("goat", "Just opened her throat and swallowed a goat!"),
+    ("cow", "I don't know how she swallowed a cow!"),
+    ("horse", "She's dead, of course!"),
+]
+
+
+def _build_verse(index):
+    animal, comment = ANIMALS[index]
+    if animal == "horse":
+        return [
+            f"I know an old lady who swallowed a horse.",
+            comment,
+        ]
+
+    lines = [
+        f"I know an old lady who swallowed a {animal}.",
+        comment,
+    ]
+
+    for i in range(index, 0, -1):
+        pred_animal, _ = ANIMALS[i]
+        curr_animal, _ = ANIMALS[i - 1]
+        if curr_animal == "spider":
+            action = f"She swallowed the {pred_animal} to catch the {curr_animal} that wriggled and jiggled and tickled inside her."
+        else:
+            action = f"She swallowed the {pred_animal} to catch the {curr_animal}."
+        lines.append(action)
+
+    lines.append("I don't know why she swallowed the fly. Perhaps she'll die.")
+    return [l for l in lines if l]
+
