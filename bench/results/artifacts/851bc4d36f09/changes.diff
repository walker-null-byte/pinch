diff --git a/work/_bench_check.py b/_bench_check.py
new file mode 100644
index 0000000..2804788
--- /dev/null
+++ b/_bench_check.py
@@ -0,0 +1,23 @@
+import sys
+from click.testing import CliRunner
+import tool
+
+def fail(msg):
+    print("FAIL:", msg)
+    sys.exit(1)
+
+runner = CliRunner()
+for value, expected in (("/etc/tool.toml", "tool 1.4.2 (config: /etc/tool.toml)\n"), ("/other.toml", "tool 1.4.2 (config: /other.toml)\n")):
+    res = runner.invoke(tool.cli, ["--version"], prog_name="tool", env={"TOOL_CONFIG": value})
+    if res.output != expected:
+        fail(f"with TOOL_CONFIG={value}: got {res.output!r}, expected {expected!r} (exit {res.exit_code})")
+res = runner.invoke(tool.cli, ["--version"], prog_name="tool", env={"TOOL_CONFIG": None})
+if res.output != "tool 1.4.2 (config: default)\n":
+    fail(f"without TOOL_CONFIG: got {res.output!r}")
+res = runner.invoke(tool.cli, ["hello"], prog_name="tool")
+if res.output != "hello\n":
+    fail(f"hello changed: {res.output!r}")
+used = [p for p in tool.cli.params if p.callback is not None and "custom_version_option" in p.callback.__qualname__]
+if not used:
+    fail("the --version option was not made with click.custom_version_option")
+print("PASS")
diff --git a/work/test_tool.py b/test_tool.py
new file mode 100644
index 0000000..52769cb
--- /dev/null
+++ b/test_tool.py
@@ -0,0 +1,29 @@
+import os
+from click.testing import CliRunner
+from tool import cli
+
+
+def sub_test_version(monkeypatch, env, expected_output):
+    runner = CliRunner()
+    if env is not None:
+        monkeypatch.setenv("TOOL_CONFIG", env)
+    else:
+        monkeypatch.delenv("TOOL_CONFIG", raising=False)
+    result = runner.invoke(cli, ["--version"])
+    assert result.exit_code == 0
+    assert result.output.strip() == expected_output
+
+
+def test_version_default(monkeypatch):
+    sub_test_version(monkeypatch, None, "tool 1.4.2 (config: default)")
+
+
+def test_version_custom(monkeypatch):
+    sub_test_version(monkeypatch, "/etc/tool.toml", "tool 1.4.2 (config: /etc/tool.toml)")
+
+
+def test_hello():
+    runner = CliRunner()
+    result = runner.invoke(cli, ["hello"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "hello"
