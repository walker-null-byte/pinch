+    def _propagate(self):
+        # 1. Identify all affected compute cells
+        affected = []
+        queue = [self]
+        visited = {self}
+        
+        while queue:
+            node = queue.pop(0)
+            if hasattr(node, 'observers'):
+                for observer in node.observers:
+                    if observer not in visited:
+                        visited.add(observer)
+                        affected.append(observer)
+                        queue.append(observer)
+        
+        # 2. Re-evaluate all affected cells in a way that respects dependencies
+        #    A simple approach: topological sort
+        
+        # 3. Trigger callbacks for cells that changed value in the final stable state
+        
+        # Let's store initial values for comparison
+        old_values = {cell: cell.value for cell in affected}
+        
+        # Topological sort of affected cells
+        # This is a bit complex, let's try a simple re-evaluation loop
+        # that will definitely be correct even if not the most efficient.
+        # Given the number of cells is likely small, this should be fine.
+        
+        changed = True
+        while changed:
+            changed = False
+            for cell in affected:
+                new_val = cell._compute()
+                if new_val != cell.value:
+                    cell.value = new_val
+                    changed = True
+        
+        # 4. Fire callbacks
+        for cell in affected:
+            if cell.value != old_values[cell]:
+                for callback in cell.callbacks:
+                    callback(cell.value)
 
