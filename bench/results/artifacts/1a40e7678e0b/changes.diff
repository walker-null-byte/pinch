diff --git a/work/tests/test_none_issue.py b/tests/test_none_issue.py
new file mode 100644
index 0000000..bf3c98a
--- /dev/null
+++ b/tests/test_none_issue.py
@@ -0,0 +1,18 @@
+from xmltodict import unparse
+import pytest
+
+def test_none_handling():
+    # 1. unparse({"a": {"@param": "test", "#text": None}}, full_document=False) == '<a param="test"></a>'
+    assert unparse({"a": {"@param": "test", "#text": None}}, full_document=False) == '<a param="test"></a>'
+    
+    # 2. unparse({"x": {"@pro": None}}, full_document=False) == '<x pro=""></x>'
+    assert unparse({"x": {"@pro": None}}, full_document=False) == '<x pro=""></x>'
+    
+    # 3. unparse({"x": {"#text": None, "@pro": None}, "y": None}, short_empty_elements=True, full_document=False) == '<x pro=""/><y/>'
+    # Wait, the example in the description suggests {"y": None} becomes <y/>
+    # Let's check what unparse does for top-level None
+    assert unparse({"x": {"#text": None, "@pro": None}, "y": None}, short_empty_elements=True, full_document=False) == '<x pro=""/><y/>'
+    
+    # 4. unparse({"a": None}, full_document=False) equals unparse({"a": {"#text": None}}, full_document=False).
+    assert unparse({"a": None}, full_document=False) == unparse({"a": {"#text": None}}, full_document=False)
+    assert unparse({"a": None}, full_document=False) == '<a></a>'
