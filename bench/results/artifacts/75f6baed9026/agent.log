The implemented list operations are functional and pass all tests. 

```python
def append(list1, list2):
    result = list1[:]
    for item in list2:
        result += [item]
    return result


def concat(lists):
    result = []
    for sublist in lists:
        result = append(result, sublist)
    return result


def filter(function, list):
    result = []
    for item in list:
        if function(item):
            result += [item]
    return result


def length(list):
    count = 0
    for _ in list:
        count += 1
    return count


def map(function, list):
    result = []
    for item in list:
        result += [function(item)]
    return result


def foldl(function, list, initial):
    acc = initial
    for item in list:
        acc = function(acc, item)
    return acc


def foldr(function, list, initial):
    acc = initial
    for item in reverse(list):
        acc = function(acc, item)
    return acc


def reverse(list):
    result = []
    for item in list:
        result = [item] + result
    return result
```

