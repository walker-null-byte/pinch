+    # Validate structure
+    try:
+        # Check first token is a number
+        res = int(tokens[0])
+    except ValueError:
+        raise ValueError("syntax error")
+        
+    i = 1
+    while i < len(tokens):
+        op = tokens[i]
+        if op not in ["+", "-", "*", "/"]:
+            raise ValueError("syntax error")
+        
+        if i + 1 >= len(tokens):
+            raise ValueError("syntax error")
+            
+        try:
+            val = int(tokens[i+1])
+        except ValueError:
+            raise ValueError("syntax error")
+            
+        if op == "+": res += val
+        elif op == "-": res -= val
+        elif op == "*": res *= val
+        elif op == "/": res //= val
+            
+        i += 2
