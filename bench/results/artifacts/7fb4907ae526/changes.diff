+    # Remove prefix and suffix
+    expr = question[7:-1].strip()
+    if not expr:
+        raise ValueError("syntax error")
+        
+    # Replace known operations with symbols
+    expr = expr.replace("plus", "+").replace("minus", "-")
+    expr = expr.replace("multiplied by", "*").replace("divided by", "/")
