+    def _propagate(self):
+        # 1. Identify all affected cells
+        # 2. Recompute them
+        # 3. Fire callbacks for those that changed.
+        
+        # Get all compute cells in the dependency tree
+        all_cells = []
+        def get_all(cell):
+            for obs in cell._observers:
+                if obs not in all_cells:
+                    all_cells.append(obs)
+                    get_all(obs)
+        get_all(self)
+        
+        # Recompute until stable (naive but works)
+        changed = True
+        while changed:
+            changed = False
+            for cell in all_cells:
+                if cell._recompute():
+                    changed = True
+        
+        # Fire callbacks for those that actually changed since last time
+        for cell in all_cells:
+            cell._notify_callbacks()
 
