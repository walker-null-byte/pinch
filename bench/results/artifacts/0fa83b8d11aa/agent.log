The reactive system implementation uses a simple dependency propagation model. When an `InputCell`'s value is set, it triggers a `_propagate` method that repeatedly recomputes all affected `ComputeCell`s until the system reaches a stable state (where no more values change). After stability is reached, `ComputeCell`s that have changed their value since the last callback notification fire their registered callbacks.

```python
class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._observers = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        if self._value != new_value:
            self._value = new_value
            self._propagate()

    def _propagate(self):
        all_cells = []
        def get_all(cell):
            for obs in cell._observers:
                if obs not in all_cells:
                    all_cells.append(obs)
                    get_all(obs)
        get_all(self)
        
        changed = True
        while changed:
            changed = False
            for cell in all_cells:
                if cell._recompute():
                    changed = True
        
        for cell in all_cells:
            cell._notify_callbacks()

class ComputeCell:
    def __init__(self, inputs, compute_function):
        self.inputs = inputs
        self.compute_function = compute_function
        self.callbacks = []
        self._value = self.compute_function([i.value for i in self.inputs])
        self._observers = []
        for input in self.inputs:
            input._observers.append(self)
        self._last_notified_value = self._value

    @property
    def value(self):
        return self._value

    def _recompute(self):
        new_value = self.compute_function([i.value for i in self.inputs])
        if new_value != self._value:
            self._value = new_value
            return True
        return False
        
    def _notify_callbacks(self):
        if self._value != self._last_notified_value:
            self._last_notified_value = self._value
            for callback in self.callbacks:
                callback(self._value)

    def add_callback(self, callback):
        self.callbacks.append(callback)

    def remove_callback(self, callback):
        if callback in self.callbacks:
            self.callbacks.remove(callback)
