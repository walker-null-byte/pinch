+import os
 import click
 
 
+class VersionMessage:
+    def __mod__(self, other):
+        ctx = click.get_current_context()
+        cmd_path = ctx.command_path
+        config_val = os.environ.get("TOOL_CONFIG", "default")
+        return f"{cmd_path} 1.4.2 (config: {config_val})"
+
+
 @click.group()
+@click.version_option("1.4.2", message=VersionMessage())
 def cli():
     """Example tool."""
 
