+import re
+
 class PhoneNumber:
-    def __init__(self, number):
-        pass
+    def __init__(self, number_str):
+        # Check for letters
+        if any(char.isalpha() for char in number_str):
+            raise ValueError("letters not permitted")
+        
+        # Check for punctuations (other than valid formatting chars like +, -, ., (), spaces)
+        # Wait, the instruction says: "if a phone number has punctuation in place of some digits." or generally invalid punctuation.
+        # Let's check what punctuation is permitted. Usually standard formatting chars: spaces, dashes, dots, parentheses, plus sign.
+        # Let's check what test_invalid_with_punctuations tests: PhoneNumber("523-@:!-7890")
+        # Let's see if there are other punctuations. Allowed chars for input: digits, spaces, '+', '-', '.', '(', ')'.
+        # If any other punctuation (or special characters like '@', '!', ':', etc.) exists, raise ValueError("punctuations not permitted").
+        
+        allowed_chars = set("0123456789 +-().")
+        if any(char not in allowed_chars for char in number_str):
+            raise ValueError("punctuations not permitted")
+
+        # Extract digits
+        digits = [c for c in number_str if c.isdigit()]
+        
+        # Check digit count
+        if len(digits) < 10:
+            raise ValueError("must not be fewer than 10 digits")
+        if len(digits) > 11:
+            raise ValueError("must not be greater than 11 digits")
+        
+        if len(digits) == 11:
+            if digits[0] != '1':
+                raise ValueError("11 digits must start with 1")
+            digits = digits[1:]
+        
+        # Now digits has 10 digits: [area_code (3), exchange_code (3), subscriber (4)]
+        area_code = "".join(digits[0:3])
+        exchange_code = "".join(digits[3:6])
+        
+        if area_code[0] == '0':
+            raise ValueError("area code cannot start with zero")
+        if area_code[0] == '1':
+            raise ValueError("area code cannot start with one")
+            
+        if exchange_code[0] == '0':
+            raise ValueError("exchange code cannot start with zero")
+        if exchange_code[0] == '1':
+            raise ValueError("exchange code cannot start with one")
+            
+        self.number = "".join(digits)
+        self.area_code = area_code
+
+    def pretty(self):
+        return f"({self.area_code})-{self.number[3:6]}-{self.number[6:]}"
