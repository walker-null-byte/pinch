+import re
+
+
 class PhoneNumber:
-    def __init__(self, number):
-        pass
+    def __init__(self, number_str):
+        if any(c.isalpha() for c in number_str):
+            raise ValueError("letters not permitted")
+        if any(not c.isalnum() and not c.isspace() and c not in "+()-. " for c in number_str):
+            raise ValueError("punctuations not permitted")
+        # Check if punctuation is used in place of digits or weird punctuation
+        # Specifically, check punctuation validity per tests. Let's check for any non-digit/non-space/non-allowed chars.
+        # Actually let's check what chars are permitted: digits, spaces, '+', '(', ')', '-', '.'
+        allowed = set("0123456789 +().-")
+        if not all(c in allowed for c in number_str):
+            raise ValueError("punctuations not permitted")
+
+        digits = "".join(filter(str.isdigit, number_str))
+
+        if len(digits) < 10:
+            raise ValueError("must not be fewer than 10 digits")
+        if len(digits) > 11:
+            raise ValueError("must not be greater than 11 digits")
+        if len(digits) == 11:
+            if not digits.startswith("1"):
+                raise ValueError("11 digits must start with 1")
+            digits = digits[1:]
+
+        area_code = digits[:3]
+        exchange_code = digits[3:6]
+
+        if area_code.startswith("0"):
+            raise ValueError("area code cannot start with zero")
+        if area_code.startswith("1"):
+            raise ValueError("area code cannot start with one")
+        if exchange_code.startswith("0"):
+            raise ValueError("exchange code cannot start with zero")
+        if exchange_code.startswith("1"):
+            raise ValueError("exchange code cannot start with one")
+
+        self.number = digits
+        self.area_code = area_code
+
+    def pretty(self):
+        return f"({self.area_code})-{self.number[3:6]}-{self.number[6:]}"
