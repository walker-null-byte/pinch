@@ -1,2 +1,12 @@
-def proverb():
-    pass
+def proverb(*args, qualifier=None):
+    if not args:
+        return []
+    
+    lines = [
+        f"For want of a {args[i]} the {args[i+1]} was lost."
+        for i in range(len(args) - 1)
+    ]
+    
+    item = f"{qualifier} {args[0]}" if qualifier else args[0]
+    lines.append(f"And all for the want of a {item}.")
+    return lines
