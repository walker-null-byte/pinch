index d1be410..c4d99a8 100644
--- a/proverb.py
+++ b/proverb.py
@@ -1,2 +1,15 @@
-def proverb():
-    pass
+def proverb(*args, qualifier=None):
+    if not args:
+        return []
+    
+    result = []
+    for i in range(len(args) - 1):
+        result.append(f"For want of a {args[i]} the {args[i+1]} was lost.")
+    
+    first = args[0]
+    if qualifier:
+        result.append(f"And all for the want of a {qualifier} {first}.")
+    else:
+        result.append(f"And all for the want of a {first}.")
+        
+    return result
