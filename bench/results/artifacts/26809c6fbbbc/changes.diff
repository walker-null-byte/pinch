@@ -0,0 +1,51 @@
+import anyio
+import pytest
+from anyio.from_thread import BlockingPortal
+from bridge import lookup_in_worker, lookup
+import sys
+import threading
+
+@pytest.mark.anyio
+async def test_lookup_in_worker_success():
+    portal_holder = [None]
+    event = threading.Event()
+
+    def worker():
+        async def main():
+            async with BlockingPortal() as portal:
+                portal_holder[0] = portal
+                event.set()
+                await anyio.sleep(5)
+        anyio.run(main)
+
+    t = threading.Thread(target=worker, daemon=True)
+    t.start()
+    event.wait()
+    portal = portal_holder[0]
+
+    res = await lookup_in_worker(portal, "hello")
+    assert res == "HELLO"
+
+@pytest.mark.anyio
+async def test_lookup_in_worker_cancellation():
+    portal_holder = [None]
+    event = threading.Event()
+
+    def worker():
+        async def main():
+            async with BlockingPortal() as portal:
+                portal_holder[0] = portal
+                event.set()
+                await anyio.sleep(5)
+        anyio.run(main)
+
+    t = threading.Thread(target=worker, daemon=True)
+    t.start()
+    event.wait()
+    portal = portal_holder[0]
+
+    with pytest.raises((anyio.get_cancelled_exc_class(), *([BaseExceptionGroup] if sys.version_info >= (3, 11) else []))):
+        async with anyio.create_task_group() as tg:
+            tg.start_soon(lookup_in_worker, portal, "hello")
+            await anyio.sleep(0.01)
+            tg.cancel_scope.cancel()
