new file mode 100644
index 0000000..ff76248
--- /dev/null
+++ b/tests/repro_issue.py
@@ -0,0 +1,15 @@
+import io
+import dotenv
+import pytest
+
+@pytest.mark.parametrize("test_input,expected_value", [
+    ("KEY= # comment", ""),
+    ("KEY=  # comment", ""),
+    ("KEY=\t# comment", ""),
+    ("KEY=a#b", "a#b"),
+    ("KEY=#novalue", "#novalue"),
+    ("KEY=# # comment", "#"),
+])
+def test_parse_inline_comment(test_input, expected_value):
+    values = dotenv.dotenv_values(stream=io.StringIO(test_input))
+    assert values.get("KEY") == expected_value
