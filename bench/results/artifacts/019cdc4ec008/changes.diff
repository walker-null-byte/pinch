diff --git a/wordy.py b/wordy.py
index 6fdad1f..fe801f2 100644
--- a/wordy.py
+++ b/wordy.py
@@ -1,2 +1,55 @@
+from operator import add, sub, mul, floordiv
+
 def answer(question):
-    pass
+    if not question.startswith("What is") or not question.endswith("?"):
+        raise ValueError("unknown operation")
+    
+    content = question[len("What is"):-1].strip()
+    if not content:
+        raise ValueError("syntax error")
+    
+    content = content.replace("multiplied by", "multiplied").replace("divided by", "divided")
+    tokens = content.split()
+    
+    ops = {"plus": add, "minus": sub, "multiplied": mul, "divided": floordiv}
+
+    # Validate first item
+    try:
+        result = int(tokens[0])
+    except ValueError:
+        # If the question is something like "What is 52 cubed?", it might have "cubed"
+        # The prompt says "if the question contains an unknown operation, raise unknown operation"
+        # If it's a "math word problem" that is malformed, it's syntax error.
+        # "What is 52 cubed?" -> unknown operation
+        # "What is 1 plus?" -> syntax error
+        # Let's check for known operations in the tokens.
+        if any(token in ops for token in tokens):
+             raise ValueError("syntax error")
+        raise ValueError("unknown operation")
+
+    if len(tokens) == 1:
+        return result
+        
+    i = 1
+    while i < len(tokens):
+        # The next token must be an operator
+        op_str = tokens[i]
+        if op_str not in ops:
+            # If we don't know it, is it syntax or unknown?
+            # Instructions: "Unsupported operations ("What is 52 cubed?")" -> unknown operation
+            # "Word problems with invalid syntax ("What is 1 plus plus 2?")" -> syntax error
+            # If it's a word that isn't a known operator AND isn't a number
+            if op_str.lstrip("-").isdigit():
+                 raise ValueError("syntax error")
+            raise ValueError("unknown operation")
+        
+        # Then next must be a number
+        try:
+            val = int(tokens[i+1])
+        except (ValueError, IndexError):
+            raise ValueError("syntax error")
+            
+        result = ops[op_str](result, val)
+        i += 2
+        
+    return result
