 def best_hands(hands):
-    pass
+    parsed = [parse_hand(h) for h in hands]
+    scored = [(evaluate_hand(h), h) for h in parsed]
+    scored.sort(key=lambda x: x[0], reverse=True)
+    best_score = scored[0][0]
+    return [h['orig'] for score, h in scored if score == best_score]
+
+def parse_hand(hand_str):
+    cards = hand_str.split()
+    card_list = []
+    for c in cards:
+        val_str = c[:-1]
+        suit = c[-1]
+        if val_str.isdigit():
+            val = int(val_str)
+        else:
+            val = {'J': 11, 'Q': 12, 'K': 13, 'A': 14}[val_str]
+        card_list.append((val, suit))
+    return {'orig': hand_str, 'cards': card_list}
+
+def evaluate_hand(hand):
+    cards = hand['cards']
+    values = sorted([c[0] for c in cards], reverse=True)
+    suits = [c[1] for c in cards]
+    is_flush = len(set(suits)) == 1
+
+    # Check straight
+    is_straight = False
+    straight_high = 0
+    # Normal straight check
+    unique_vals = sorted(list(set(values)), reverse=True)
+    if len(unique_vals) == 5 and unique_vals[0] - unique_vals[4] == 4:
+        is_straight = True
+        straight_high = unique_vals[0]
+    # Ace-low straight check: A, 5, 4, 3, 2 (values: 14, 5, 4, 3, 2)
+    elif set(values) == {14, 5, 4, 3, 2}:
+        is_straight = True
+        straight_high = 5
+        values = [5, 4, 3, 2, 1]
+
+    # Frequency counts
+    from collections import Counter
+    counts = Counter(values)
+    # sort by count descending, then by value descending
+    freq_sorted = sorted(counts.items(), key=lambda x: (x[1], x[0]), reverse=True)
+    
+    # Categories:
+    # 8: Straight flush
+    # 7: Four of a kind
+    # 6: Full house
+    # 5: Flush
+    # 4: Straight
+    # 3: Three of a kind
+    # 2: Two pair
+    # 1: One pair
+    # 0: High card
+
+    if is_flush and is_straight:
+        return (8, straight_high)
+    
+    if freq_sorted[0][1] == 4:
+        # Four of a kind: (7, quad_val, kicker)
+        quad_val = freq_sorted[0][0]
+        kicker = freq_sorted[1][0]
+        return (7, quad_val, kicker)
+
+    if freq_sorted[0][1] == 3 and freq_sorted[1][1] == 2:
+        # Full house: (6, triplet_val, pair_val)
+        return (6, freq_sorted[0][0], freq_sorted[1][0])
+
+    if is_flush:
+        return (5, values)
+
+    if is_straight:
+        return (4, straight_high)
+
+    if freq_sorted[0][1] == 3:
+        # Three of a kind: (3, triplet_val, kickers...)
+        trip_val = freq_sorted[0][0]
+        kickers = [x[0] for x in freq_sorted[1:]]
+        return (3, trip_val, kickers)
+
+    if freq_sorted[0][1] == 2 and freq_sorted[1][1] == 2:
+        # Two pair: (2, high_pair, low_pair, kicker)
+        pairs = sorted([freq_sorted[0][0], freq_sorted[1][0]], reverse=True)
+        kicker = freq_sorted[2][0]
+        return (2, pairs[0], pairs[1], kicker)
+
+    if freq_sorted[0][1] == 2:
+        # One pair: (1, pair_val, kickers...)
+        pair_val = freq_sorted[0][0]
+        kickers = [x[0] for x in freq_sorted[1:]]
+        return (1, pair_val, kickers)
+
+    # High card: (0, values)
+    return (0, values)
