@@ -0,0 +1,16 @@
+import humanize
+import pytest
+
+def test_intword_large_power_rounding():
+    # 10**24 - 1 should be 1 septillion (approx)
+    # The current implementation returns 1000.0 sextillion for 10**24 - 1
+    # which is essentially 1000 * 10**21.
+    # 1 septillion = 10**24
+    
+    val = 10**24 - 1
+    result = humanize.intword(val)
+    assert result == "1.0 septillion"
+
+    val2 = 10**27 - 1
+    result2 = humanize.intword(val2)
+    assert result2 == "1.0 octillion"
