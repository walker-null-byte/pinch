+
+    all_tokens = []
+    for line in input_data:
+        all_tokens.extend(line.split())
+    
+    # We will use a more robust token expansion
+    # For user-defined words, we'll store their expanded definitions.
+    # When defining, we check if a word in the definition is already a custom word
+    # and expand it at definition time.
+    
+    i = 0
+    while i < len(all_tokens):
+        token = all_tokens[i].lower()
+        
+        if token == ':':
+            i += 1
+            word_name = all_tokens[i].lower()
+            if is_number(word_name):
+                raise ValueError("illegal operation")
+            
+            i += 1
+            definition = []
+            while all_tokens[i].lower() != ';':
+                t = all_tokens[i].lower()
+                if t in custom_words:
+                    definition.extend(custom_words[t])
+                else:
+                    definition.append(t)
+                i += 1
+            custom_words[word_name] = definition
+        elif token in custom_words:
+            # We already expanded the definition at definition time.
+            # So just add it to the tokens list.
+            new_tokens = custom_words[token]
+            all_tokens[i+1:i+1] = new_tokens
+        elif is_number(token):
+            stack.append(int(token))
+        elif token == '+':
+            if len(stack) < 2:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            b = stack.pop()
+            a = stack.pop()
+            stack.append(a + b)
+        elif token == '-':
+            if len(stack) < 2:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            b = stack.pop()
+            a = stack.pop()
+            stack.append(a - b)
+        elif token == '*':
+            if len(stack) < 2:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            b = stack.pop()
+            a = stack.pop()
+            stack.append(a * b)
+        elif token == '/':
+            if len(stack) < 2:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            b = stack.pop()
+            a = stack.pop()
+            if b == 0:
+                raise ZeroDivisionError("divide by zero")
+            stack.append(int(a / b))
+        elif token == 'dup':
+            if len(stack) < 1:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            stack.append(stack[-1])
+        elif token == 'drop':
+            if len(stack) < 1:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            stack.pop()
+        elif token == 'swap':
+            if len(stack) < 2:
+                raise StackUnderflowError("Insufficient number of items in stack")
+            a = stack.pop()
+            b = stack.pop()
