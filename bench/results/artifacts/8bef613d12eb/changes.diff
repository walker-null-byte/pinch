+++ b/tests/test_tlru_overwrite.py
@@ -0,0 +1,19 @@
+import unittest
+from cachetools import TLRUCache
+
+class TestTLRUCacheOverwriting(unittest.TestCase):
+    def test_overwrite_with_expired(self):
+        def ttu(_key, value, now):
+            return now + value
+
+        cache = TLRUCache(maxsize=2, ttu=ttu)
+        # Value of 0 means expired immediately (at time 0)
+        cache[1] = 5
+        self.assertEqual(cache[1], 5)
+        
+        # Overwrite with expired value
+        cache[1] = 0
+        
+        self.assertNotIn(1, cache, "Key should have been removed")
+        self.assertEqual(len(cache), 0, "Cache should be empty")
+        self.assertEqual(cache.currsize, 0, "Cache currsize should be 0")
