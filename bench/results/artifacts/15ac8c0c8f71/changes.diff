+    ordinal = 0
+    while ordinal < len(powers) - 1 and value >= powers[ordinal + 1]:
+        ordinal += 1
+    
+    power = powers[ordinal]
+    chopped = value / power
+    # Use the format string to round
+    rounded_value = float(format % chopped)
+    
+    # The condition is if rounded_value is >= 1000
+    # But for a million it is 1000.0 * 1000 = 1000000.
+    # The requirement is that it shouldn't be "1000.0 sextillion"
