+            else:
+                # Unexpected character or structure
+                raise ValueError("tree missing")
+
+        if i >= n or input_string[i] != ')':
+            raise ValueError("tree missing")
+        i += 1 # consume ')'
+
+        if not nodes:
+            raise ValueError("tree with no nodes")
+
+        # Construct SgfTree hierarchy from the list of nodes in this branch
