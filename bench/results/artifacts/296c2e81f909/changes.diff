@@ -0,0 +1,98 @@
+import anyio
+import pytest
+from anyio.from_thread import BlockingPortal
+from bridge import lookup, lookup_in_worker
+
+async def run_worker(portal_holder):
+    async with BlockingPortal() as portal:
+        portal_holder.append(portal)
+        await portal.sleep_until_stopped()
+
+@pytest.mark.anyio
+async def test_lookup_in_worker():
+    portal_holder = []
+    
+    async def worker_thread_runner():
+        await anyio.to_thread.run_sync(anyio.run, run_worker, portal_holder)
+
+    # Start worker thread in background
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(worker_thread_runner)
+        while not portal_holder:
+            await anyio.sleep(0.001)
+        
+        portal = portal_holder[0]
+        result = await lookup_in_worker(portal, "hello")
+        assert result == "HELLO"
+        
+        # Stop portal
+        await portal.stop()
+        tg.cancel_scope.cancel()
+
+@pytest.mark.anyio
+async def test_lookup_non_blocking():
+    portal_holder = []
+    
+    async def worker_thread_runner():
+        await anyio.to_thread.run_sync(anyio.run, run_worker, portal_holder)
+
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(worker_thread_runner)
+        while not portal_holder:
+            await anyio.sleep(0.001)
+        
+        portal = portal_holder[0]
+        other_task_ran = False
+
+        async def other_task():
+            nonlocal other_task_ran
+            await anyio.sleep(0.01)
+            other_task_ran = True
+
+        async with anyio.create_task_group() as sub_tg:
+            sub_tg.start_soon(other_task)
+            result = await lookup_in_worker(portal, "world")
+            assert result == "WORLD"
+        assert other_task_ran
+
+        await portal.stop()
+        tg.cancel_scope.cancel()
+
+@pytest.mark.anyio
+async def test_lookup_cancellation():
+    portal_holder = []
+    
+    async def worker_thread_runner():
+        await anyio.to_thread.run_sync(anyio.run, run_worker, portal_holder)
+
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(worker_thread_runner)
+        while not portal_holder:
+            await anyio.sleep(0.001)
+        
+        portal = portal_holder[0]
+        cancelled = False
+
+        async def slow_lookup(name: str):
+            nonlocal cancelled
+            try:
+                await anyio.sleep(1.0)
+            except anyio.get_cancelled_exc_class():
+                cancelled = True
+                raise
+            return name
+
+        async def task_func():
+            await portal.call_async(slow_lookup, "test")
+
+        with pytest.raises(anyio.get_cancelled_exc_class()):
+            async with anyio.create_task_group() as sub_tg:
+                sub_tg.start_soon(task_func)
+                sub_tg.cancel_scope.cancel()
+
+        # Give the worker a moment to process cancellation
+        await anyio.sleep(0.05)
+        assert cancelled
+
+        await portal.stop()
+        tg.cancel_scope.cancel()
