+    bindings = list(parse_stream(io.StringIO(content)))
+    print(f"Content: '{content}' -> Bindings: {bindings}")
+    # The binding should be (key, value, error)
+    # The requirement says value should be ""
+    value = bindings[0][1]
+    if value == "":
+        print(f"  Success: value is empty string.")
+    else:
+        print(f"  Failure: value is '{value}', expected ''")
+
