--- /dev/null
+++ b/test_parse_value_6.py
@@ -0,0 +1,24 @@
+from dotenv.parser import Reader, _equal_sign, parse_value
+import io
+
+content = "KEY= # comment"
+# The problem is that _equal_sign = make_regex(r"(=[^\S\r\n]*)")
+# _equal_sign eats the space after =
+# In "KEY= # comment", the space after '=' is eaten by _equal_sign.
+# So reader is now at "# comment".
+
+# Then parse_value(reader) is called.
+# parse_value(reader) sees '#' at peek(1).
+# char = reader.peek(1) which is '#'.
+# So it calls parse_unquoted_value(reader).
+
+# parse_unquoted_value calls read_regex(_unquoted_value)
+# _unquoted_value = make_regex(r"([^\r\n]*)")
+# It eats everything until the newline.
+# So "part" becomes "# comment"
+
+# Then re.sub(r"\s+#.*", "", part) is called on "# comment".
+# \s+ matches one or more whitespace.
+# In "# comment", there is NO leading whitespace.
+# So \s+ doesn't match!
+# So it doesn't replace anything.
