+import io, dotenv
+from dotenv.parser import parse_stream, Binding
+
+def check(content, expected_value):
+    print(f"Testing: '{content}'")
+    bindings = list(parse_stream(io.StringIO(content)))
+    value = bindings[0].value
+    if value == expected_value:
+        print(f"  Success: value is '{value}'")
+    else:
+        print(f"  Failure: expected '{expected_value}', got '{value}'")
+
+# - `KEY=val # comment` -> "val"  (unchanged)
+# - No whitespace before the `#` means it is part of the value, as before: 
+#   `KEY=a#b` -> "a#b", `KEY=#novalue` -> "#novalue", `KEY=# # comment` -> "#"
+
+check("KEY=val # comment", "val")
+check("KEY=a#b", "a#b")
+check("KEY=#novalue", "#novalue")
+check("KEY=# # comment", "#")
