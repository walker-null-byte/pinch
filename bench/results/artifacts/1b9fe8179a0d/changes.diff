@@ -0,0 +1,22 @@
+import anyio
+import pytest
+from anyio.from_thread import BlockingPortal
+from bridge import lookup, lookup_in_worker
+
+
+@pytest.mark.anyio
+async def test_lookup_in_worker():
+    async with BlockingPortal() as portal:
+        res = await lookup_in_worker(portal, "hello")
+        assert res == "HELLO"
+
+
+@pytest.mark.anyio
+async def test_cancellation():
+    async with BlockingPortal() as portal:
+        async def cancel_me():
+            with anyio.fail_after(0.01):
+                await lookup_in_worker(portal, "hello")
+
+        with pytest.raises(TimeoutError):
+            await cancel_me()
