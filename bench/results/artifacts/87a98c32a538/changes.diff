diff --git a/work/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 0000000..bdd8aef
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,18 @@
+import more_itertools as mi
+from unittest import TestCase
+
+class TestBucketValidator(TestCase):
+    def test_bucket_falsey_validator(self):
+        class AllowedKeys(set):
+            def __call__(self, key):
+                return key in self
+        allowed = AllowedKeys()          # empty, so bool(allowed) is False
+        D = mi.bucket(iter([10, 20, 11, 21]), key=lambda x: x, validator=allowed)
+        
+        self.assertEqual(list(D[10]), [])
+        self.assertFalse(10 in D)
+        self.assertEqual(set(D), set())
+
+if __name__ == "__main__":
+    import unittest
+    unittest.main()
