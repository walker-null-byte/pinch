@@ -0,0 +1,28 @@
+from xmltodict import unparse
+
+# Case 1
+res1 = unparse({"a": {"@param": "test", "#text": None}}, full_document=False)
+print(f"Case 1: {res1!r}")
+expected1 = '<a param="test"></a>'
+assert res1 == expected1, f"Expected {expected1}, got {res1}"
+
+# Case 2
+res2 = unparse({"x": {"@pro": None}}, full_document=False)
+print(f"Case 2: {res2!r}")
+expected2 = '<x pro=""></x>'
+assert res2 == expected2, f"Expected {expected2}, got {res2}"
+
+# Case 3
+res3 = unparse({"x": {"#text": None, "@pro": None}, "y": None}, short_empty_elements=True, full_document=False)
+print(f"Case 3: {res3!r}")
+expected3 = '<x pro=""/><y/>'
+assert res3 == expected3, f"Expected {expected3}, got {res3}"
+
+# Case 4
+res4 = unparse({"a": None}, full_document=False)
+print(f"Case 4: {res4!r}")
+# Based on the requirement: unparse({"a": None}, full_document=False) equals unparse({"a": {"#text": None}}, full_document=False)
+expected4 = unparse({"a": {"#text": None}}, full_document=False)
+assert res4 == expected4, f"Expected {expected4}, got {res4}"
+
+print("All tests passed!")
