+    def _propagate(self):
+        # Build the graph and identify all affected cells.
+        affected = []
+        queue = list(self.observers)
+        visited = set()
+        
+        while queue:
+            cell = queue.pop(0)
+            if cell not in visited:
+                visited.add(cell)
+                affected.append(cell)
+                queue.extend(cell.observers)
+        
+        # Topological sort for dependencies
+        # Since it's a small graph, just re-order until no dependencies are out of order
+        # Actually, sorting by depth in the dependency graph is standard
+        sorted_affected = []
+        def get_depth(c, memo):
+            if c in memo: return memo[c]
+            if not hasattr(c, 'inputs'): return 0
+            depth = 0
+            for i in c.inputs:
+                depth = max(depth, get_depth(i, memo) + 1)
+            memo[c] = depth
+            return depth
+        
+        memo = {}
+        affected.sort(key=lambda c: get_depth(c, memo))
+        
+        # Update cells
+        old_values = {cell: cell.value for cell in affected}
+        
+        for cell in affected:
+            cell.update()
+            
+        # Notify callbacks
+        for cell in affected:
+            if cell.value != old_values[cell]:
