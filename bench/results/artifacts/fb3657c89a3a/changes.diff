+                if frames[-1][0] + pins > 10:
+                    raise ValueError("pin count exceeds 10 in frame")
+
+        self.rolls.append(pins)
+
+    def score(self) -> int:
+        if not self._is_game_completed():
+            raise ValueError("score cannot be calculated for incomplete game")
+
+        total_score = 0
+        roll_index = 0
+        frames = self._parse_frames(self.rolls)
+
+        for frame_idx in range(10):
+            f_rolls = frames[frame_idx]
+            if frame_idx == 9:
+                total_score += sum(f_rolls)
+            else:
+                if f_rolls[0] == 10: # Strike
+                    total_score += 10 + self.rolls[roll_index + 1] + self.rolls[roll_index + 2]
+                    roll_index += 1
+                elif len(f_rolls) >= 2 and f_rolls[0] + f_rolls[1] == 10: # Spare
+                    total_score += 10 + self.rolls[roll_index + 2]
+                    roll_index += 2
+                else: # Open frame
+                    total_score += sum(f_rolls[:2])
+                    roll_index += len(f_rolls)
+
+        return total_score
+
+    def _parse_frames(self, rolls):
+        frames = []
+        i = 0
+        for frame_num in range(10):
+            if i >= len(rolls):
+                break
+            if frame_num == 9:
+                frames.append(rolls[i:i+3])
+                i = len(rolls)
+            else:
+                if rolls[i] == 10:
+                    frames.append([10])
+                    i += 1
+                else:
+                    if i + 1 < len(rolls):
+                        frames.append([rolls[i], rolls[i+1]])
+                        i += 2
+                    else:
+                        frames.append([rolls[i]])
+                        i += 1
+        return frames
+
+    def _is_game_finished(self):
+        frames = self._parse_frames(self.rolls)
+        if len(frames) < 10:
+            return False
+        f10 = frames[9]
+        if f10[0] == 10:
+            return len(f10) == 3
+        elif len(f10) >= 2 and f10[0] + f10[1] == 10:
+            return len(f10) == 3
+        elif len(f10) == 2:
+            return True
+        return False
+
+    def _is_game_completed(self):
+        return self._is_game_finished()
