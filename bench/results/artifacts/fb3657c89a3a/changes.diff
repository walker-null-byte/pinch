+
+        if current_frame == 10:
+            f10 = frames[9]
+            if len(f10) == 1:
+                if f10[0] == 10 and pins > 10:
+                    raise ValueError("bonus roll after strike cannot exceed 10")
+            elif len(f10) == 2:
+                if f10[0] == 10:
+                    if f10[1] < 10 and f10[1] + pins > 10:
+                        raise ValueError("second bonus roll after strike cannot exceed remaining pins")
+                    if f10[1] == 10 and pins > 10:
+                        raise ValueError("second bonus roll after strike cannot exceed 10")
