--- a/grep.py
+++ b/grep.py
@@ -1,2 +1,67 @@
 def grep(pattern, flags, files):
-    pass
+    flag_list = flags.split() if flags else []
+    print_line_numbers = "-n" in flag_list
+    print_file_names = "-l" in flag_list
+    case_insensitive = "-i" in flag_list
+    invert = "-v" in flag_list
+    match_entire = "-x" in flag_list
+
+    results = []
+    multiple_files = len(files) > 1
+
+    for file_name in files:
+        file_has_match = False
+        with open(file_name, "r") as f:
+            for line_no, line in enumerate(f, 1):
+                stripped_line = line.rstrip("\n")
+                
+                # Check match
+                p = pattern
+                l = stripped_line
+                if case_insensitive:
+                    p = p.lower()
+                    l = l.lower()
+                
+                if match_entire:
+                    matched = (l == p)
+                else:
+                    matched = (p in l)
+
+                if invert:
+                    matched = not matched
+
+                if matched:
+                    file_has_match = True
+                    if print_file_names:
+                        break # Only need one match to record file name
+                    
+                    output_parts = []
+                    if multiple_files:
+                        output_parts.append(file_name)
+                    if print_line_numbers:
+                        output_parts.append(str(line_no))
+                    output_parts.append(stripped_line)
+
+                    # How are parts joined? Filename:linenumber:line
+                    # Let's check format from tests:
+                    # "2:Of that Forbidden Tree..."
+                    # "paradise-lost.txt"
+                    # "iliad.txt:Of Atreus..."
+                    # "9:Of Atreus, Agamemnon, King of men."
+                    # If multiple_files and print_line_numbers: file_name:line_no:line
+                    # Wait, prefix construction:
+                    # If multiple_files: start with file_name + ":"
+                    # If print_line_numbers: add line_no + ":"
+                    # Actually let's construct precisely:
+                    prefix = ""
+                    if multiple_files:
+                        prefix += file_name + ":"
+                    if print_line_numbers:
+                        prefix += str(line_no) + ":"
+                    results.append(prefix + stripped_line)
+
+        if file_has_match and print_file_names:
+            results.append(file_name)
+
+    return "\n".join(results) + ("\n" if results else "")
+
