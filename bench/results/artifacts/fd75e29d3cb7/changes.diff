diff --git a/work/tests/repro_tlru.py b/tests/repro_tlru.py
new file mode 100644
index 0000000..2c226d4
--- /dev/null
+++ b/tests/repro_tlru.py
@@ -0,0 +1,30 @@
+from cachetools import TLRUCache
+
+def test_tlru_overwrite_expired():
+    def ttu(_key, value, now):
+        return now + value
+
+    timer = [0]
+    def some_timer():
+        return timer[0]
+
+    cache = TLRUCache(maxsize=2, ttu=ttu, timer=some_timer)
+    cache[1] = 5
+    assert cache[1] == 5
+    assert len(cache) == 1
+    
+    # Overwrite with expired value
+    cache[1] = 0
+    assert 1 not in cache
+    assert cache.get(1) is None
+    assert len(cache) == 0
+    assert cache.currsize == 0
+    assert set(cache) == set()
+
+if __name__ == "__main__":
+    try:
+        test_tlru_overwrite_expired()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
diff --git a/tests/test_tlru.py b/tests/test_tlru.py
index b1263d7..b0dac65 100644
--- a/tests/test_tlru.py
+++ b/tests/test_tlru.py
@@ -144,6 +144,26 @@ class TLRUCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertEqual(cache[4], 4)
         self.assertEqual(cache[5], 5)
 
+    def test_overwrite_existing_with_expired(self):
+        # Overwriting an existing key with an already-expired value must not
+        # silently retain the previous value: the assignment cannot store the
+        # new (dead-on-arrival) value, so the key has to be evicted instead.
+        def ttu(_k, value, t):
+            return t + value
+
+        cache = TLRUCache[int, int, int](maxsize=2, ttu=ttu, timer=Timer())
+        cache[1] = 5
+        self.assertEqual(cache[1], 5)
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.currsize, 1)
+
+        cache[1] = 0  # ttu -> t, i.e. not (t < t): immediately expired
+        self.assertNotIn(1, cache)
+        self.assertIsNone(cache.get(1))
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.currsize, 0)
+        self.assertEqual(set(cache), set())
+
     def test_ttu_expire(self):
         def ttu(_k, _v, t):
             return t + 3
