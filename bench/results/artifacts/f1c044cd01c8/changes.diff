--- /dev/null
+++ b/test_cli.py
@@ -0,0 +1,22 @@
+from click.testing import CliRunner
+import cli
+
+def test_cli_help():
+    runner = CliRunner()
+    result = runner.invoke(cli.greet, ["--help"])
+    assert result.exit_code == 0
+    assert "Positional arguments:" in result.output
+    assert "Who to greet." in result.output
+    assert "How many times to greet." in result.output
+
+def test_cli_execution():
+    runner = CliRunner()
+    result = runner.invoke(cli.greet, ["Alice", "2"])
+    assert result.exit_code == 0
+    assert result.output == "Hello, Alice!\nHello, Alice!\n"
+
+def test_cli_execution_shout():
+    runner = CliRunner()
+    result = runner.invoke(cli.greet, ["Bob", "1", "--shout"])
+    assert result.exit_code == 0
+    assert result.output == "HELLO, BOB!\n"
