+    stack = []
+    dictionary = {}
+
+    # Built-in arithmetic and stack manipulation words
+    def op_add():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        b = stack.pop()
+        a = stack.pop()
+        stack.append(a + b)
+
+    def op_sub():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        b = stack.pop()
+        a = stack.pop()
+        stack.append(a - b)
+
+    def op_mul():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        b = stack.pop()
+        a = stack.pop()
+        stack.append(a * b)
+
+    def op_div():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        b = stack.pop()
+        a = stack.pop()
+        if b == 0:
+            raise ZeroDivisionError("divide by zero")
+        stack.append(int(a / b))
+
+    def op_dup():
+        if len(stack) < 1:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        stack.append(stack[-1])
+
+    def op_drop():
+        if len(stack) < 1:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        stack.pop()
+
+    def op_swap():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        b = stack.pop()
+        a = stack.pop()
+        stack.append(b)
+        stack.append(a)
+
+    def op_over():
+        if len(stack) < 2:
+            raise StackUnderflowError("Insufficient number of items in stack")
+        stack.append(stack[-2])
+
+    builtins = {
+        "+": op_add,
+        "-": op_sub,
+        "*": op_mul,
+        "/": op_div,
+        "dup": op_dup,
+        "drop": op_drop,
+        "swap": op_swap,
+        "over": op_over,
