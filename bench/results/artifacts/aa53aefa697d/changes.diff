+    def is_number(token):
+        # A number is a sequence of one or more ASCII digits, optionally preceded by '-'
+        if token.isdigit():
+            return True
+        if token.startswith("-") and token[1:].isdigit():
+            return True
+        return False
+
+    def compile_token(token):
+        tok_lower = token.lower()
+        if is_number(token):
+            val = int(token)
+            return lambda: stack.append(val)
