{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": true,
    "enforce_auth_on_inference": true
  },
  "providers": {
    "cloud-a": {
      "keys": [
        {
          "name": "cloud-a-key",
          "value": "env.MOCK_PROVIDER_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8101",
        "max_retries": 0,
        "default_request_timeout_in_seconds": 20
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true
        }
      }
    },
    "cloud-b": {
      "keys": [
        {
          "name": "cloud-b-key",
          "value": "env.MOCK_PROVIDER_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8102",
        "max_retries": 0,
        "default_request_timeout_in_seconds": 20
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true
        }
      }
    },
    "local": {
      "keys": [
        {
          "name": "local-key",
          "value": "env.MOCK_PROVIDER_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8103",
        "max_retries": 0,
        "default_request_timeout_in_seconds": 20
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true
        }
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-alice",
        "name": "alice",
        "value": "env.PINCH_VK_ALICE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cloud-a",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "cloud-b",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "local",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-bob",
        "name": "bob",
        "value": "env.PINCH_VK_BOB",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cloud-a",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "cloud-b",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "local",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-penny",
        "name": "penny",
        "value": "env.PINCH_VK_PENNY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "cloud-a",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "cloud-b",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          },
          {
            "provider": "local",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      },
      {
        "id": "vk-confidential",
        "name": "confidential",
        "value": "env.PINCH_VK_CONFIDENTIAL",
        "is_active": true,
        "allow_all_providers": false,
        "provider_configs": [
          {
            "provider": "local",
            "allowed_models": [
              "mock-small",
              "mock-big"
            ],
            "key_ids": [
              "*"
            ],
            "weight": 1
          }
        ]
      }
    ],
    "budgets": [
      {
        "id": "budget-alice",
        "max_limit": 1.0,
        "reset_duration": "1M",
        "virtual_key_id": "vk-alice"
      },
      {
        "id": "budget-bob",
        "max_limit": 0.25,
        "reset_duration": "1M",
        "virtual_key_id": "vk-bob"
      },
      {
        "id": "budget-penny",
        "max_limit": 0.01,
        "reset_duration": "1M",
        "virtual_key_id": "vk-penny"
      }
    ],
    "routing_rules": [
      {
        "id": "route-alice",
        "name": "alice: cloud-a, then cloud-b, then local",
        "cel_expression": "true",
        "scope": "virtual_key",
        "scope_id": "vk-alice",
        "priority": 1,
        "targets": [
          {
            "provider": "cloud-a",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "cloud-b/",
          "local/"
        ]
      },
      {
        "id": "route-bob",
        "name": "bob: cloud-a, then cloud-b, then local",
        "cel_expression": "true",
        "scope": "virtual_key",
        "scope_id": "vk-bob",
        "priority": 1,
        "targets": [
          {
            "provider": "cloud-a",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "cloud-b/",
          "local/"
        ]
      },
      {
        "id": "route-penny",
        "name": "penny: cloud-a, then cloud-b, then local",
        "cel_expression": "true",
        "scope": "virtual_key",
        "scope_id": "vk-penny",
        "priority": 1,
        "targets": [
          {
            "provider": "cloud-a",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "cloud-b/",
          "local/"
        ]
      }
    ],
    "pricing_overrides": [
      {
        "id": "00000000-0000-4000-8000-000000000001",
        "name": "mock-small demo price",
        "scope_kind": "global",
        "match_type": "exact",
        "pattern": "mock-small",
        "request_types": [
          "chat_completion"
        ],
        "pricing_patch": "{\"input_cost_per_token\":0.000001,\"output_cost_per_token\":0.000004}"
      },
      {
        "id": "00000000-0000-4000-8000-000000000002",
        "name": "mock-big demo price",
        "scope_kind": "global",
        "match_type": "exact",
        "pattern": "mock-big",
        "request_types": [
          "chat_completion"
        ],
        "pricing_patch": "{\"input_cost_per_token\":0.000003,\"output_cost_per_token\":0.000012}"
      }
    ],
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": true
    }
  },
  "setup_token": "env.BIFROST_SETUP_TOKEN",
  "vector_store": {
    "enabled": true,
    "type": "chromem"
  },
  "plugins": [
    {
      "enabled": true,
      "name": "semantic_cache",
      "config": {
        "dimension": 1,
        "ttl": "1h",
        "conversation_history_threshold": 50,
        "cache_tool_call_responses": true,
        "cache_by_model": true,
        "cache_by_provider": true,
        "default_cache_key": ""
      }
    }
  ]
}
