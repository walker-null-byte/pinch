# Copy to .env and fill in. Names only here; never commit real values.
# pinch loads .env from $PINCH_ENV_FILE, ~/.config/pinch/.env, or the pinch source checkout.
# It never loads a .env from the repo being worked on.

# --- pinch -> Bifrost -------------------------------------------------------------------------
# The gateway's OpenAI-compatible endpoint.
PINCH_BASE_URL=http://127.0.0.1:8180/v1
PINCH_MODEL=gemini/gemini-3.5-flash-lite
# Model name sent for the local tier (confidential repos, and 'continue on the local tier'). Empty = same as PINCH_MODEL.
PINCH_LOCAL_MODEL=local/gemma4
# Tools offered on the local tier (confidential repos, "continue on the local tier") when PINCH_LOCAL_MODEL is set: a small direct set, sent in full mode.
# PINCH_LOCAL_TOOLS=read_file,list_directory,grep_search,edit_file,write_file,run_test,run_command
# Your Bifrost virtual key (sk-bf-...). Budget and routing are tied to it.
PINCH_GATEWAY_KEY=
# Header that carries the key. Bifrost reads x-bf-vk. "Authorization" would send "Bearer <key>".
PINCH_KEY_HEADER=x-bf-vk
# A virtual key that can reach ONLY local providers. Required for confidential repos.
PINCH_CONFIDENTIAL_KEY=
PINCH_CONFIDENTIAL_VK_ID=vk-confidential
# Your key's id in Bifrost, so pinch can read the remaining budget.
PINCH_BUDGET_VK_ID=vk-me
# Gateway admin login (read-only use: budget and the confidential-key check). Not your virtual key.
PINCH_GATEWAY_ADMIN_USER=admin
PINCH_GATEWAY_ADMIN_PASSWORD=
# One-time token the real gateway needs to switch on its admin login (gateway/config.real.json).
PINCH_GATEWAY_SETUP_TOKEN=
# Gemini-only virtual key with a $15 budget and no fallback, for `pinch.bench run` (model never switches mid-benchmark).
PINCH_BENCH_KEY=
# Demo keys: a $0.01 budget (shows the budget stop) and a key whose primary provider is down (shows failover).
PINCH_DEMO_LOW_KEY=
PINCH_FAILOVER_DEMO_KEY=
# Fallback spending limit in USD for pinch's own ledger, used when Bifrost can't report your budget.
# PINCH_BUDGET_USD=

# --- token-saving techniques ---------------------------------------------------------------------
# all | none | comma list: context,filememory,smalledits,testcompress,trim,pretest,stopongreen,cascade,prefix,cache,docs
# PINCH_SAVINGS=all
# Cascade: model names per tier (the gateway must route both). Empty = no cascade.
PINCH_SMALL_MODEL=gemini/gemini-3.5-flash-lite
PINCH_BIG_MODEL=gemini/gemini-3.6-flash
# Test command for stop-on-green. Empty = coding-tools finds the repo's own.
# PINCH_TEST_COMMAND=
# Tavily docs_lookup: used only when the `docs` technique is on and the repo is not confidential.
TAVILY_API_KEY=
# PINCH_TAVILY_URL=https://api.tavily.com
# Bifrost cache namespace. Empty = a fresh one per run (the session id), so runs never share answers.
# PINCH_CACHE_KEY=

# --- provider keys, read by the gateway (docker compose env), never by pinch --------------------
# `uv run python scripts/init_env.py` fills the empty virtual keys, admin password and setup token with random values (it never prints them).
# OPENROUTER_API_KEY and ANTHROPIC_API_KEY are not used by config.real.json.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Key sent to the local model server (LM Studio and Ollama ignore it, Bifrost wants one).
LOCAL_PROVIDER_KEY=lm-studio

# Optional
# PINCH_STYLE=brief
# PINCH_MODE=lazy
# PINCH_MAX_STEPS=30
# PINCH_SESSION_DIR=
